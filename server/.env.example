# ==============================================================================
# GitHub Profile Finder — Environment Variables Configuration
# ==============================================================================
# NOTE: This file is a template containing placeholder values only.
# Copy this file to '.env' and fill in your values. Never commit '.env' to git!

# Server port (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed client origin for CORS (e.g. http://localhost:3000 in dev, or your production domain)
CLIENT_ORIGIN=http://localhost:3000

# Optional GitHub Personal Access Token (PAT)
# If provided, increases rate limit from 60 to 5,000 requests/hour and enables live GraphQL contributions.
# Permissions required: 'read:user' or public data only. DO NOT GRANT WRITE ACCESS.
# Leave blank to run in unauthenticated mode (60 requests/hour IP limit).
GITHUB_TOKEN=your_github_personal_access_token_here

# In-Memory Cache Time-To-Live in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Rate Limiter Window & Max Requests per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

